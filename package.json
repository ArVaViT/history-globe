{
  "name": "history-globe",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": ">=24.11 <27"
  },
  "scripts": {
    "dev": "pnpm --filter @hg/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "data": "python3 pipeline/build_data.py && node scripts/build-content.ts",
    "gate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:pipeline && pnpm content && pnpm build && node scripts/check-budget.ts",
    "gate:full": "pnpm data && pnpm gate",
    "test:pipeline": "python3 -m unittest discover -s pipeline -q",
    "content": "node scripts/build-content.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2",
    "yaml": "2.9.1",
    "@types/geojson": "7946.0.16",
    "@types/node": "24.19.0"
  }
}
