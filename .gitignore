# Dependencies
node_modules/
.pnpm-store/
.venv/
__pycache__/
*.pyc

# Build output
dist/
build/
.turbo/
coverage/
playwright-report/
test-results/

# Geo pipeline: raw downloads and generated tiles never go to git
pipeline/.cache/
pipeline/out/
*.pmtiles
*.mbtiles
*.tif
*.zip

# Secrets and local env (secrets live in 1Password, see AGENTS.md)
.env
.env.*
!.env.example

# OS / editors
.DS_Store
.idea/
*.swp

# Generated map data (rebuilt by `pnpm data`)
apps/web/public/data/

# Generated pages (scripts/build-pages.ts)
# Generated pages, one folder per language (two letters): a new language is ignored too.
apps/web/public/[a-z][a-z]/
# …but the link previews, one picture a language (hg-tools og-shots), are kept.
!apps/web/public/og/
apps/web/public/sitemap.xml
apps/web/public/llms.txt
# What IndexNow compares (scripts/build-page-hashes.ts)
apps/web/public/page-hashes.json
# The open data as files (scripts/build-api.ts)
apps/web/public/api/
apps/web/public/docs/
db/seed/

# The source maps of the build, kept out of dist/ (vite.config.ts, sourceMapsAside)
apps/web/maps/

# Vercel CLI (project link and local builds; deploys are prebuilt, ADR 0012)
.vercel/
