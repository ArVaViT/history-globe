{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/docs",
      "destination": "/docs/",
      "permanent": true
    },
    {
      "source": "/docs/:lang(ru|uk|es|pt|de|fr|it|nl|pl|cs)",
      "destination": "/docs/:lang/",
      "permanent": true
    },
    {
      "source": "/:lang(en|ru|uk|es|pt|de|fr|it|nl|pl|cs)/place/moab-aa0b1d6",
      "destination": "/:lang/place/moab/",
      "permanent": true
    },
    {
      "source": "/:lang(en|ru|uk|es|pt|de|fr|it|nl|pl|cs)/place/moab-aa0b1d6/",
      "destination": "/:lang/place/moab/",
      "permanent": true
    },
    {
      "source": "/:lang(en|ru|uk|es|pt|de|fr|it|nl|pl|cs)/place/moab-aca767b",
      "destination": "/:lang/place/plains-of-moab/",
      "permanent": true
    },
    {
      "source": "/:lang(en|ru|uk|es|pt|de|fr|it|nl|pl|cs)/place/moab-aca767b/",
      "destination": "/:lang/place/plains-of-moab/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, no-cache"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, no-cache"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/data/text-places.(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/hg-places.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/hg-places-(.*).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/((?!embed/).*)",
      "missing": [
        {
          "type": "query",
          "key": "embed"
        }
      ],
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "script-src 'self' 'sha256-N9v3EnPaUyp6HvI/g75KoK11mUw7quk1fPSwEhREnaU=' 'sha256-tSxlaRGrCnaz2NJBg7uLlSE6mRxg4i8DOFX+HPScWQ8=' 'sha256-ZE71wwM7L0Ln6UFft8E3ioGycQBLtl8su48sr7XV9kY=' 'sha256-RqZ8glMbj/NFhk9dBGIFvOhoxe9pHw+JK0MSF3t062I=' 'sha256-ayNywZ7nQY9RYo16jcN6IkAUqhKs2YwdLNgCe3Bnj4o=' 'sha256-x3dEI/Olp4Bxrv0A9S1p/Lvt5Gw7D2IHrnYOmRzweyk='; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "query",
          "key": "embed"
        }
      ],
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "script-src 'self' 'sha256-N9v3EnPaUyp6HvI/g75KoK11mUw7quk1fPSwEhREnaU=' 'sha256-tSxlaRGrCnaz2NJBg7uLlSE6mRxg4i8DOFX+HPScWQ8=' 'sha256-ZE71wwM7L0Ln6UFft8E3ioGycQBLtl8su48sr7XV9kY=' 'sha256-RqZ8glMbj/NFhk9dBGIFvOhoxe9pHw+JK0MSF3t062I=' 'sha256-ayNywZ7nQY9RYo16jcN6IkAUqhKs2YwdLNgCe3Bnj4o=' 'sha256-x3dEI/Olp4Bxrv0A9S1p/Lvt5Gw7D2IHrnYOmRzweyk='; object-src 'none'; base-uri 'self'; frame-ancestors *"
        }
      ]
    },
    {
      "source": "/embed/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "script-src 'self' 'sha256-N9v3EnPaUyp6HvI/g75KoK11mUw7quk1fPSwEhREnaU=' 'sha256-tSxlaRGrCnaz2NJBg7uLlSE6mRxg4i8DOFX+HPScWQ8=' 'sha256-ZE71wwM7L0Ln6UFft8E3ioGycQBLtl8su48sr7XV9kY=' 'sha256-RqZ8glMbj/NFhk9dBGIFvOhoxe9pHw+JK0MSF3t062I=' 'sha256-ayNywZ7nQY9RYo16jcN6IkAUqhKs2YwdLNgCe3Bnj4o=' 'sha256-x3dEI/Olp4Bxrv0A9S1p/Lvt5Gw7D2IHrnYOmRzweyk='; object-src 'none'; base-uri 'self'; frame-ancestors *"
        }
      ]
    }
  ]
}
