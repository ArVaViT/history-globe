{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/docs",
      "destination": "/docs/",
      "permanent": true
    },
    {
      "source": "/docs/:lang(ru|uk|es|pt|de|fr|it|nl|pl|cs|sv|nb)",
      "destination": "/docs/:lang/",
      "permanent": true
    },
    {
      "source": "/:lang(en|ru|uk|es|pt|de|fr|it|nl|pl|cs|sv|nb)/place/moab-aa0b1d6",
      "destination": "/:lang/place/moab/",
      "permanent": true
    },
    {
      "source": "/:lang(en|ru|uk|es|pt|de|fr|it|nl|pl|cs|sv|nb)/place/moab-aa0b1d6/",
      "destination": "/:lang/place/moab/",
      "permanent": true
    },
    {
      "source": "/:lang(en|ru|uk|es|pt|de|fr|it|nl|pl|cs|sv|nb)/place/moab-aca767b",
      "destination": "/:lang/place/plains-of-moab/",
      "permanent": true
    },
    {
      "source": "/:lang(en|ru|uk|es|pt|de|fr|it|nl|pl|cs|sv|nb)/place/moab-aca767b/",
      "destination": "/:lang/place/plains-of-moab/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/data/((?!articles/|photos/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, no-cache"
        },
        {
          "key": "Link",
          "value": "<https://creativecommons.org/licenses/by/4.0/>; rel=\"license\""
        }
      ]
    },
    {
      "source": "/data/photos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, no-cache"
        }
      ]
    },
    {
      "source": "/data/articles/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, no-cache"
        },
        {
          "key": "Link",
          "value": "<https://creativecommons.org/licenses/by-nc-nd/4.0/>; rel=\"license\""
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, no-cache"
        }
      ]
    },
    {
      "source": "/api/((?!v1/questions\\.json).*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "Link",
          "value": "<https://creativecommons.org/licenses/by/4.0/>; rel=\"license\", <https://historyglobe.app/api/v1/openapi.json>; rel=\"service-desc\", <https://historyglobe.app/docs/build.html>; rel=\"service-doc\""
        }
      ]
    },
    {
      "source": "/api/v1/questions.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "Link",
          "value": "<https://creativecommons.org/licenses/by-nc-nd/4.0/>; rel=\"license\", <https://historyglobe.app/api/v1/openapi.json>; rel=\"service-desc\", <https://historyglobe.app/docs/build.html>; rel=\"service-doc\""
        }
      ]
    },
    {
      "source": "/data/text-places.(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/hg-places.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/hg-places-(.*).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "tdm-reservation",
          "value": "1"
        }
      ]
    },
    {
      "source": "/((?!embed/).*)",
      "missing": [
        {
          "type": "query",
          "key": "embed"
        }
      ],
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-N9v3EnPaUyp6HvI/g75KoK11mUw7quk1fPSwEhREnaU=' 'sha256-tSxlaRGrCnaz2NJBg7uLlSE6mRxg4i8DOFX+HPScWQ8=' 'sha256-ZE71wwM7L0Ln6UFft8E3ioGycQBLtl8su48sr7XV9kY=' 'sha256-RqZ8glMbj/NFhk9dBGIFvOhoxe9pHw+JK0MSF3t062I=' 'sha256-ukG0y5SlgGATM6Orcjw9enABOC5YptoYdv2lpb2RSgk=' 'sha256-x3dEI/Olp4Bxrv0A9S1p/Lvt5Gw7D2IHrnYOmRzweyk=' 'sha256-JRuXynS0C2BP9jfWW+qTBvcxD8sWpo9sQyO2tG9K2Ck='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tiles.mapterhorn.com https://historyglobe.app; font-src 'self' data:; connect-src 'self' data: blob: https://tiles.mapterhorn.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "query",
          "key": "embed"
        }
      ],
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-N9v3EnPaUyp6HvI/g75KoK11mUw7quk1fPSwEhREnaU=' 'sha256-tSxlaRGrCnaz2NJBg7uLlSE6mRxg4i8DOFX+HPScWQ8=' 'sha256-ZE71wwM7L0Ln6UFft8E3ioGycQBLtl8su48sr7XV9kY=' 'sha256-RqZ8glMbj/NFhk9dBGIFvOhoxe9pHw+JK0MSF3t062I=' 'sha256-ukG0y5SlgGATM6Orcjw9enABOC5YptoYdv2lpb2RSgk=' 'sha256-x3dEI/Olp4Bxrv0A9S1p/Lvt5Gw7D2IHrnYOmRzweyk=' 'sha256-JRuXynS0C2BP9jfWW+qTBvcxD8sWpo9sQyO2tG9K2Ck='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tiles.mapterhorn.com https://historyglobe.app; font-src 'self' data:; connect-src 'self' data: blob: https://tiles.mapterhorn.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors *"
        }
      ]
    },
    {
      "source": "/embed/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-N9v3EnPaUyp6HvI/g75KoK11mUw7quk1fPSwEhREnaU=' 'sha256-tSxlaRGrCnaz2NJBg7uLlSE6mRxg4i8DOFX+HPScWQ8=' 'sha256-ZE71wwM7L0Ln6UFft8E3ioGycQBLtl8su48sr7XV9kY=' 'sha256-RqZ8glMbj/NFhk9dBGIFvOhoxe9pHw+JK0MSF3t062I=' 'sha256-ukG0y5SlgGATM6Orcjw9enABOC5YptoYdv2lpb2RSgk=' 'sha256-x3dEI/Olp4Bxrv0A9S1p/Lvt5Gw7D2IHrnYOmRzweyk=' 'sha256-JRuXynS0C2BP9jfWW+qTBvcxD8sWpo9sQyO2tG9K2Ck='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tiles.mapterhorn.com https://historyglobe.app; font-src 'self' data:; connect-src 'self' data: blob: https://tiles.mapterhorn.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors *"
        }
      ]
    }
  ]
}
